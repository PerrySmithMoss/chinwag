{
  "name": "server",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "prisma generate && rm -rf dist && tsc --project tsconfig.build.json",
    "build:production": "yarn build && prisma migrate deploy",
    "test": "tsx --test \"src/**/__tests__/*.test.ts\"",
    "test:watch": "tsx --test --watch \"src/**/__tests__/*.test.ts\"",
    "test:coverage": "tsx --test --experimental-test-coverage \"src/**/__tests__/*.test.ts\""
  },
  "license": "MIT",
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.2",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "7.10.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": "26.x"
  }
}
